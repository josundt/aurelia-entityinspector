{
  "version": "2.0.0",
  "runner": "terminal",
  "tasks": [
    {
      "label": "compile:and:lint",
      "dependsOn": [
        "compile:ts:root",
        "compile:ts:build",
        "compile:ts:src",
        "lint:style",
        "lint:html",
        "lint:ts:root",
        "lint:ts:build",
        "lint:ts:src"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "compile",
      "dependsOn": ["compile:ts:root", "compile:ts:build", "compile:ts:src"],
      "dependsOrder": "parallel",
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "compile:ts:root",
      "type": "npm",
      "script": "compile:ts:root",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "compile:ts:build",
      "type": "npm",
      "script": "compile:ts:build",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "compile:ts:src",
      "type": "npm",
      "script": "compile:ts:src",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "lint",
      "dependsOn": [
        "lint:style",
        "lint:html",
        "lint:ts:root",
        "lint:ts:build",
        "lint:ts:src"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "lint:ts:root",
      "type": "npm",
      "script": "lint:ts:root",
      "problemMatcher": "$eslint-stylish",
      "group": "build"
    },
    {
      "label": "lint:ts:build",
      "type": "npm",
      "script": "lint:ts:build",
      "problemMatcher": "$eslint-stylish",
      "group": "build"
    },
    {
      "label": "lint:ts:src",
      "type": "npm",
      "script": "lint:ts:src",
      "problemMatcher": "$eslint-stylish",
      "group": "build"
    },
    {
      "label": "lint:style",
      "type": "shell",
      "command": "npx",
      "args": [
        "stylelint",
        "'src/**/*.{css,scss}'",
        "-f",
        "unix",
        "--allow-empty-input"
      ],
      "group": "build",
      "problemMatcher": {
        "fileLocation": "absolute",
        "owner": "Stylelint",
        "source": "Stylelint",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (.+ \\((.*)\\)) \\[(error|warning|info)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5,
          "severity": 6
        }
      }
    },
    {
      "label": "lint:html",
      "type": "shell",
      "command": "npx",
      "args": [
        "htmlhint",
        "src",
        "-c",
        "./node_modules/@josundt/htmlhint-config/.htmlhintrc",
        "--format",
        "compact",
        "--ignore",
        "**/*-svg.html"
      ],
      "group": "build",
      "problemMatcher": {
        "applyTo": "allDocuments",
        "severity": "error",
        "fileLocation": "absolute",
        "owner": "htmlhint",
        "source": "",
        "pattern": [
          {
            "regexp": "(.*): line (\\d+), col (\\d+), (.*) - (.*) \\((.+)\\)",
            "file": 1,
            "line": 2,
            "column": 3,
            //"severity": 4,
            "message": 5,
            "code": 6
          }
        ]
      }
    }
  ]
}
