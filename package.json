{
  "name": "aurelia-entityinspector",
  "version": "1.5.0",
  "description": "An Aurelia ui component for viewing JavaScript values (plugin)",
  "main": "./dist/es2015-esm/index.js",
  "module": "./dist/es2015-esm/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/es2022-esm/index.js"
    }
  },
  "scripts": {
    "compile": "npm run compile:ts:root && npm run compile:ts:build && npm run compile:ts:src",
    "compile:ts:root": "tsc -p tsconfig.json --noemit",
    "compile:ts:build": "tsc -p build/tsconfig.json --noemit",
    "compile:ts:src": "tsc -p src/tsconfig.json --noemit",
    "format": "npm run format:html && npm run format:style && npm run format:ts",
    "format:ts": "prettier --config .prettierrc src/**/*.ts --write",
    "format:html": "prettier --config .prettierrc src/**/*.{html,ejs} --write",
    "format:style": "prettier --config .prettierrc src/**/*.{css,scss} --write",
    "lint": "npm run lint:html && npm run lint:style && npm run lint:ts:root && npm run lint:ts:build && npm run lint:ts:src",
    "lint:ts:root": "eslint ./*.ts -f stylish",
    "lint:ts:build": "eslint build -f stylish",
    "lint:ts:src": "eslint src -f stylish",
    "lint:style": "stylelint **/*.{css,scss} --allow-empty-input -f unix",
    "lint:html": "htmlhint src -c ./node_modules/@josundt/htmlhint-config/.htmlhintrc --format unix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prebuild": "npm run clean",
    "build": "tsc -p src/tsconfig.es2015-esm.json && tsc -p src/tsconfig.es2022-esm.json && node ./build/build.ts",
    "clean": "rimraf -g ./dist/**/*"
  },
  "files": [
    "src",
    "dist",
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josundt/aurelia-entityinspector.git"
  },
  "keywords": [],
  "author": "Jørn Andre Sundt",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/josundt/aurelia-entityinspector/issues"
  },
  "homepage": "https://github.com/josundt/aurelia-entityinspector#readme",
  "devDependencies": {
    "@josundt/eslint-config": "6.0.2",
    "@josundt/htmlhint-config": "1.9.2",
    "@josundt/stylelint-config": "17.6.1",
    "@josundt/tsconfig-rules": "6.0.0",
    "@types/node": "^26.6.6",
    "aurelia-framework": "^1.4.1",
    "rimraf": "6.1.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "aurelia-framework": "^1.4.1"
  }
}
